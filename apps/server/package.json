{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- npx --yes auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/trpc": "^1.1.0",
    "@hono/trpc-server": "^0.4.2",
    "@real-estate-scrapper/api": "*",
    "@real-estate-scrapper/auth": "*",
    "@real-estate-scrapper/db": "*",
    "@sinclair/typebox": "^0.34.52",
    "@trpc/server": "^11.18.0",
    "better-auth": "1.7.7",
    "elysia": "^1.4.30",
    "libsql": "0.5.29",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@real-estate-scrapper/config": "*",
    "@types/node": "^26.4.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
